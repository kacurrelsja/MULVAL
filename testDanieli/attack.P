%========================
% XSB Tabling Optimization Directives (Must be at the absolute top)
%========================
:-table dos/2.
:-table execCode/2.
:-table netAccess/5.
:-table spoofLinkHost/5.
:-table unauthorizedControl/1.
:-table domainCompromise/1.

:-dynamic primitive/1.
:-dynamic derived/1.

%=============================
% Core Schema Definitions
%=============================

primitive(vulHost/5).
primitive(vulLinkProtocol/5).
primitive(networkService/5).
primitive(malicious/1).
primitive(located/3).
primitive(isGateway/2).
primitive(isMaster/2).
primitive(isSlave/2).
primitive(l2Connection/5).
primitive(sameCredentials/2).
primitive(isDomainController/2).

derived(dos/2).
derived(execCode/2).
derived(netAccess/5).
derived(spoofLinkHost/5).
derived(unauthorizedControl/1).
derived(domainCompromise/1).

%===================================
% Static Vulnerability Database
%===================================
% Unified 'opcua_server' casing to match environmentNetwork.P string joins
vulHost(plc_l1_, 'CVE-2022-25888', opcua_server, remoteExploit, dos).
vulHost(fortim_gateway, 'CVE-2022-40684', customPacketFilter, remoteExploit, accessControlBypass).
vulLinkProtocol(sub_process_area_1, vul_modbus_no_auth, modbus, adjacent, impersonateDst).

%=====================================
% Core Interaction Rules
%=====================================

% Rule 1: Remote Denial of Service
interaction_rule(
    (dos(Principal, TargetHost):-
        networkService(TargetHost, Program, Protocol, Port, _ServicePrivilege),
        vulHost(TargetHost, VulId, Program, remoteExploit, dos),
        netAccess(Principal, _AttackerSource, TargetHost, Protocol, Port),
        malicious(Principal)),
    rule_desc('Remote Denial of Service execution via software service vulnerability', 1.0)
).

% Rule 2 : Basic Privelege Exploitation to Code Execution
interaction_rule(
    (execCode(TargetHost, UserPerm):-
        networkService(TargetHost, Program, Protocol, Port, UserPerm),
        vulHost(TargetHost, VulId, Program, remoteExploit, privilegeEscalation),
        netAccess(_Principal, _AttackrerSource, TargetHost, Protocol, Port)),
    rule_desc('Standard remote code execution via software service vulnerability', 1.0)
).

% Rule 3 : Network Perimeter Bypass Rule via Gateway Exploit
interaction_rule(
    (netAccess(Principal, AttackerSource, ProtectedHost, Protocol, Port):-
        located(AttackerSource, SubnetA, ipSubnet),
        isGateway(GatewayDevice, SubnetA),
        isGateway(GatewayDevice, SubnetB),
        vulHost(GatewayDevice, _VulId, _FilterService, remoteExploit, accessControlBypass),
        malicious(Principal)),
    rule_desc('Network perimeter bypass via exploit on edge gateway', 1.0)
).

% Rule 4: Industrial Network Link Spoofing
interaction_rule(
    (spoofLinkHost(Principal, ImpersonateMaster, FooledSlave, AttackerHost, deception):-
        vulLinkProtocol(BusID, _VulId, Protocol, adjacent, impersonateDst),
        l2Connection(AttackerHost, FooledSlave, BusID, Protocol, bus),
        isMaster(ImpersonateMaster, BusID),
        malicious(Principal)),
    rule_desc('Spoofing as a bus Master due to the lack of protocol authentication', 1.0)
).

% Rule 5 : Lateral Movement via Shared Credentials (Loop Oritected 6 Tabled)
interaction_rule(
    (execCode(TargetHost, admin):-
        execCode(CompromisedHost, admin),
        CompromisedHost \== TargetHost,
        sameCredentials(CompromisedHost, TargetHost),
        netAccess(_Principal, CompromisedHost, TargetHost, _, _)),
    rule_desc('Lateral movement via shared administrative credentials', 1.0)
).

% Rule 6 : Command Injection over Unauthenticated Bus
interaction_rule(
    (unauthorizedControl(TargetPLc):-
        execCode(AttackerWorkstation, admin),
        netAccess(_Principal, AttackerWorkstation, TargetPLC, tcp, 502)),
    rule_desc('Unauthorized industrial command inejction via unauthorized protocol', 0.8)
).

% Rule 7 : Complete Active Directory Domain Takeover
interaction_rule(
    (domainCompromise(DomainID):-
        execCode(DC_Host, admin),
        isDomainController(DC_Host, DomainID)),
    rule_desc('Full domain takeover via domain controller compromise', 1.0)
).
