/******************************************************/
/****   Core Interaction Rules (canonical, deduped) ***/
/******************************************************/


% Rule 1: Perimeter Reachability via Ingress Firewall ACL
interaction_rule(
    (netAccess(Principal, AttackerSource, TargetHost, Protocol, Port) :-
        attackerLocated(AttackerSource),
        malicious(Principal),
        aclNW(AttackerSource, TargetHost, Protocol, Port)),
    rule_desc('Direct network reachability via permissible ACL policy', 1.0)
).

% Rule 2: Multi-Hop Lateral Reachability from Compromised Node
interaction_rule(
    (netAccess(Principal, CompromisedNode, TargetHost, Protocol, Port) :-
        execCode(CompromisedNode, _Perm),
        malicious(Principal),
        aclNW(CompromisedNode, TargetHost, Protocol, Port)),
    rule_desc('Network reachability from compromised intermediate host', 1.0)
).

% Rule 3: Remote Code Execution via Software CVE
interaction_rule(
    (execCode(TargetHost, Privilege) :-
        networkService(TargetHost, Program, Protocol, Port, Privilege),
        vulHost(TargetHost, _VulId, Program, remoteExploit, privEscalation),
        netAccess(_Principal, _AttackerSource, TargetHost, Protocol, Port)),
    rule_desc('Remote code execution via vulnerable network service', 1.0)
). 

% Rule 4: Lateral Movement via Shared Administrative Credentials
interaction_rule(
    (execCode(TargetHost, admin) :-
        execCode(CompromisedHost, admin),
        sameCredentials(CompromisedHost, TargetHost)),
    rule_desc('Lateral movement across hosts via shared administrative credentials', 1.0)
).

% Rule 5: Active Directory Domain Controller Compromise
interaction_rule(
    (domainCompromise(DomainID) :-
        execCode(DCHost, admin),
        isDomainController(DCHost, DomainID)),
    rule_desc('Complete domain takeover via Domain Controller administrative compromise', 1.0)
).

% Rule 6: Unauthorized Industrial Control Injection (Modbus/TCP)
interaction_rule(
    (unauthorizedControl(TargetPLC) :-
        execCode(SupervisorHost, admin),
        aclNW(SupervisorHost, TargetPLC, tcp, 502),
        networkService(TargetPLC, _Service, tcp, 502, _Perm)),
    rule_desc('Unauthorized industrial command injection into PLC over unauthenticated Modbus/TCP', 0.9)
).

% Rule 7: Bridging Unauthorized Control to Execution Privilege
interaction_rule(
    (execCode(TargetPLC, root) :-
        unauthorizedControl(TargetPLC)),
    rule_desc('Unauthorized control of industrial controller yields root execution privilege', 1.0)
).

% Rule 8: Denial of Service via OPC UA Vulnerability
interaction_rule(
    (dos(Principal, TargetPLC) :-
        malicious(Principal),
        networkService(TargetPLC, opcua_server, tcp, 4840, _Perm),
        vulHost(TargetPLC, cve_2022_25888, opcua_server, remoteExploit, dos),
        aclNW(SourceNode, TargetPLC, tcp, 4840),
        execCode(SourceNode, _Perm2)),
    rule_desc('Denial of Service against Level 1 OPC UA server disabling control-loop communications', 1.0)
).

% Rule 9: Physical Drive Actuation via PROFINET Bus Link
interaction_rule(
    (physicalDriveControl(AttackerNode, SlaveDrive) :-
        execCode(AttackerNode, _Perm),
        l2Connection(AttackerNode, SlaveDrive, BusID, profinet, bus),
        isMaster(MasterPLC, BusID),
        isSlave(SlaveDrive, BusID),
        unauthorizedControl(MasterPLC)),
    rule_desc('Unauthorized physical drive actuation via unauthenticated PROFINET bus link', 1.0)
).
% Rule 10: Historian Telemetry Tampering
interaction_rule(
    (processDataTampering(SourcePDA, TargetHD) :-
        dataFlow(SourcePDA, TargetHD, FlowID, twoWay),
        flowBind(FlowID, tcp, Port),
        networkService(TargetHD, iba_historian, tcp, Port, _Perm),
        execCode(SourcePDA, _Perm2)),
    rule_desc('Tampering and falsification of historical telemetry data streams', 0.8)
).

% --- Standard Host/File Access Fallbacks ---

interaction_rule(
    (canAccessHost(H) :-
        execCode(H, _Perm)),
    rule_desc('Access a host through executing code on the machine', 1.0)
).

interaction_rule(
    (accessFile(H, Access, Path) :-
        execCode(H, Usr),
        canAccessFile(H, Usr, Access, Path)),
    rule_desc('execCode implies file access', 1.0)
).

interaction_rule(
    (principalCompromised(Victim) :-
        hasAccount(Victim, H, root),
        execCode(H, root)),
    rule_desc('Password sniffing via root access', 0.8)
).
